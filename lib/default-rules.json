[
  {
    "id": "private-key",
    "name": "Private key",
    "type": "regex",
    "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]+?-----END [A-Z ]*PRIVATE KEY-----",
    "flags": "g",
    "replacement": "",
    "enabled": true
  },
  {
    "id": "jwt",
    "name": "JWT",
    "type": "regex",
    "pattern": "\\beyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+",
    "flags": "g",
    "validate": "jwt",
    "replacement": "",
    "enabled": true
  },
  {
    "id": "api-key",
    "name": "API key",
    "type": "regex",
    "pattern": "(?<![A-Za-z0-9_-])(?:sk-(?:ant-|proj-)?[A-Za-z0-9_-]{20,}|(?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}|ABSK[A-Za-z0-9+/]{109,269}={0,2}|AIza[0-9A-Za-z_-]{35}|gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,}|gl(?:pat|dt|ffct|ft|imt|agent|oas|ptt|rt|soat|cbt)-[0-9A-Za-z_.-]{20,300}|GR1348941[A-Za-z0-9_-]{20}|xox[abeoprs]-[A-Za-z0-9-]{10,}|xapp-\\d-[A-Za-z0-9-]{10,}|(?:sk|rk)_(?:test|live|prod)_[A-Za-z0-9]{10,99}|sq0(?:atp|csp)-[A-Za-z0-9_-]{22,60}|SG\\.[A-Za-z0-9=_.-]{66}|xkeysib-[a-f0-9]{64}-[A-Za-z0-9]{16}|SK[0-9a-fA-F]{32}|shp(?:at|ca|pa|ss)_[a-fA-F0-9]{32}|npm_[A-Za-z0-9]{36}|pypi-AgEIcHlwaS5vcmc[A-Za-z0-9_-]{50,1000}|rubygems_[a-f0-9]{48}|CLOJARS_[A-Za-z0-9]{60}|do[opr]_v1_[a-f0-9]{64}|hf_[A-Za-z]{34}|api_org_[A-Za-z]{34}|pplx-[A-Za-z0-9]{48}|lin_api_[A-Za-z0-9]{40}|ntn_[0-9]{11}[A-Za-z0-9]{35}|PMAK-[a-fA-F0-9]{24}-[a-fA-F0-9]{34}|sntryu_[a-f0-9]{64}|sntrys_eyJpYXQiO[A-Za-z0-9+/=_-]{40,}|glc_[A-Za-z0-9+/]{32,400}={0,3}|glsa_[A-Za-z0-9]{32}_[A-Fa-f0-9]{8}|eyJrIjoi[A-Za-z0-9]{70,400}={0,3}|dapi[a-f0-9]{32}(?:-\\d)?|dt0c01\\.[A-Za-z0-9]{24}\\.[A-Za-z0-9]{64}|pul-[a-f0-9]{40}|dp\\.pt\\.[A-Za-z0-9]{43}|hv[sb]\\.[A-Za-z0-9_-]{90,300}|pscale_(?:tkn|oauth|pw)_[A-Za-z0-9_=.-]{32,64}|HRKU-AA[0-9A-Za-z_-]{58}|fo1_[A-Za-z0-9_-]{43}|LTAI[A-Za-z0-9]{20}|AKCp[A-Za-z0-9]{69}|pnu_[A-Za-z0-9]{36}|ico-[A-Za-z0-9]{32}|rdme_[a-z0-9]{70}|shippo_(?:live|test)_[a-fA-F0-9]{40}|v1\\.0-[a-f0-9]{24}-[a-f0-9]{146}|ops_eyJ[A-Za-z0-9+/]{250,}={0,3}|A3-[A-Z0-9]{6}-(?:[A-Z0-9]{11}|[A-Z0-9]{6}-[A-Z0-9]{5})-[A-Z0-9]{5}-[A-Z0-9]{5}-[A-Z0-9]{5}|AGE-SECRET-KEY-1[QPZRY9X8GF2TVDW0S3JN54KHCE6MUA7L]{58}|[0-9]{8,10}:AA[0-9A-Za-z_-]{33})",
    "flags": "g",
    "replacement": "",
    "enabled": true
  },
  {
    "id": "secret-assign",
    "name": "Secret",
    "type": "regex",
    "pattern": "(?<=\\b(?:password|passwd|pwd|passwort|contraseña|mot de passe|secret|token|api[_-]?key)\\s*[:=]\\s*[\"']?)[^\\s\"',;]+",
    "flags": "gi",
    "replacement": "",
    "enabled": true
  },
  {
    "id": "email",
    "name": "Email",
    "type": "regex",
    "pattern": "(?<![A-Za-z0-9._%+-])(?<!://(?:[^\\s:/@]{1,100}:)?)[A-Za-z0-9._%+-]{1,64}@(?:[A-Za-z0-9-]{1,63}\\.){1,8}[A-Za-z]{2,24}(?![A-Za-z0-9-])",
    "flags": "g",
    "replacement": "",
    "enabled": true
  },
  {
    "id": "iban",
    "name": "IBAN",
    "type": "regex",
    "pattern": "\\b[A-Z]{2}\\d{2}(?: ?[A-Z0-9]{4}){3,7}(?: ?[A-Z0-9]{1,3})?\\b",
    "flags": "g",
    "validate": "iban",
    "replacement": "",
    "enabled": true
  },
  {
    "id": "card",
    "name": "Card",
    "type": "regex",
    "pattern": "\\b(?:\\d{4}[ -]?){3}\\d{4}\\b|\\b3[47]\\d{2}[ -]?\\d{6}[ -]?\\d{5}\\b",
    "flags": "g",
    "validate": "luhn",
    "replacement": "",
    "enabled": true
  },
  {
    "id": "dni-es",
    "name": "National ID",
    "type": "regex",
    "pattern": "\\b[XYZ]?\\d{7,8}[- ]?[TRWAGMYFPDXBNJZSQVHLCKE]\\b",
    "flags": "gi",
    "validate": "dni-es",
    "replacement": "",
    "enabled": true
  },
  {
    "id": "phone-es",
    "name": "Phone",
    "type": "regex",
    "pattern": "(?:\\+34[ -]?)?\\b[6789]\\d{2}[ -]?\\d{3}[ -]?\\d{3}\\b",
    "flags": "g",
    "replacement": "",
    "enabled": true
  },
  {
    "id": "ipv4",
    "name": "IPv4",
    "type": "regex",
    "pattern": "\\b(?:(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\b",
    "flags": "g",
    "replacement": "",
    "enabled": true
  },
  {
    "id": "phone-intl",
    "name": "Phone",
    "type": "regex",
    "pattern": "(?<![\\w+])\\+[1-9]\\d{0,2}[ .-]?(?:\\(\\d{1,4}\\)[ .-]?)?\\d{1,4}(?:[ .-]?\\d{1,4}){1,4}(?!\\w)",
    "flags": "g",
    "validate": "phone-intl",
    "replacement": "",
    "enabled": true
  },
  {
    "id": "url-password",
    "name": "Password",
    "type": "regex",
    "pattern": "(?<=\\b[A-Za-z][A-Za-z0-9+.-]{1,20}://[^\\s:/@]{1,100}:)[^\\s@/]{1,200}(?=@)",
    "flags": "g",
    "replacement": "",
    "enabled": true
  },
  {
    "id": "auth-header",
    "name": "Token",
    "type": "regex",
    "pattern": "(?<=\\b(?:Proxy-)?Authorization\\s*[:=]\\s*[\"']?(?:Bearer|Basic|Token|Digest)\\s+)[A-Za-z0-9._~+/=-]{8,}",
    "flags": "gi",
    "replacement": "",
    "enabled": true
  },
  {
    "id": "cookie-header",
    "name": "Cookie",
    "type": "regex",
    "pattern": "(?<=^[ \\t]*(?:Set-)?Cookie:[^\\r\\n]*?\\b(?!(?:Path|Domain|Expires|Max-Age|SameSite|Priority|Partitioned)=)[\\w.!#$%&'*+^`|~-]+=)[^;\\r\\n]+",
    "flags": "gim",
    "replacement": "",
    "enabled": true
  },
  {
    "id": "user-assign",
    "name": "User",
    "type": "regex",
    "pattern": "(?<=\\b(?:user(?:name)?|login|uid|usuario)\\s*[:=]\\s*[\"']?)[^\\s\"',;&()<>]{2,64}",
    "flags": "gi",
    "replacement": "",
    "enabled": false
  },
  {
    "id": "webhook",
    "name": "Webhook",
    "type": "regex",
    "pattern": "https://(?:hooks\\.slack\\.com/(?:services|workflows|triggers)/[A-Za-z0-9+/]{20,80}|(?:ptb\\.|canary\\.)?discord(?:app)?\\.com/api/webhooks/\\d+/[A-Za-z0-9_-]{60,80}|[a-z0-9-]+\\.webhook\\.office\\.com/webhookb2/[^\\s\"'<>]+)",
    "flags": "g",
    "replacement": "",
    "enabled": true
  }
]
